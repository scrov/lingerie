{
  "name": "@lingerie/cms",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "typecheck": "tsc -p tsconfig.json",
    "test": "tsx --test test/*.test.ts",
    "cf-typegen": "wrangler types",
    "db:migrate": "wrangler d1 migrations apply lingerie-cms --remote",
    "db:migrate:local": "wrangler d1 migrations apply lingerie-cms --local"
  },
  "devDependencies": {
    "tsx": "^4.20.0",
    "typescript": "~6.0.2",
    "wrangler": "4.156.0"
  },
  "engines": {
    "node": ">=22"
  }
}
